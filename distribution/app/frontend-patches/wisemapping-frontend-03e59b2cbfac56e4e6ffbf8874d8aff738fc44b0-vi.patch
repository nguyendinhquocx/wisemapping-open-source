diff --git a/packages/editor/test/unit/i18n/locale-messages.test.ts b/packages/editor/test/unit/i18n/locale-messages.test.ts
index 0ed8f0e6..cd614476 100644
--- a/packages/editor/test/unit/i18n/locale-messages.test.ts
+++ b/packages/editor/test/unit/i18n/locale-messages.test.ts
@@ -34,0 +35,22 @@ const locales = fs
+const messageTokens = (message: string): string[] => {
+  const tokens: string[] = [];
+  for (let i = 0; i < message.length; i += 1) {
+    if (message[i] !== '{') continue;
+    let depth = 1;
+    let end = i + 1;
+    while (end < message.length && depth > 0) {
+      if (message[end] === '{') depth += 1;
+      if (message[end] === '}') depth -= 1;
+      end += 1;
+    }
+    if (depth !== 0) continue;
+    const expression = message.slice(i + 1, end - 1);
+    const icu = expression.match(/^([\w.-]+)\s*,\s*(plural|select|selectordinal)\s*,/);
+    if (icu) tokens.push(`icu:${icu[1]}:${icu[2]}`);
+    else if (/^[\w.-]+$/.test(expression)) tokens.push(`arg:${expression}`);
+    i = end - 1;
+  }
+  const tags = message.match(/<\/?[A-Za-z][A-Za-z0-9]*>/g) ?? [];
+  return [...tokens, ...tags.map((tag) => `tag:${tag}`)].sort();
+};
+
@@ -111,0 +134,12 @@ describe.each(locales)('%s messages', (lang) => {
+describe('Vietnamese message integrity', () => {
+  const vi = readLang('vi');
+
+  test('preserves all English message placeholders and rich-text tags', () => {
+    Object.entries(en).forEach(([id, message]) => {
+      expect(messageTokens(vi[id]?.defaultMessage ?? '')).toEqual(
+        messageTokens(message.defaultMessage),
+      );
+    });
+  });
+});
+
