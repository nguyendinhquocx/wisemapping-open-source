+ *   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *   See the License for the specific language governing permissions and
+ *   limitations under the License.
+ */
+
+import AppI18n, { Locales } from '../../../src/classes/app-i18n';
+
+const originalLanguages = navigator.languages;
+
+const setBrowserLanguages = (...languages: string[]): void => {
+  Object.defineProperty(navigator, 'languages', {
+    configurable: true,
+    value: languages,
+  });
+};
+
+describe('AppI18n locale selection', () => {
+  beforeEach(() => {
+    localStorage.clear();
+    window.history.replaceState({}, '', '/maps');
+    setBrowserLanguages('vi-VN');
+  });
+
+  afterEach(() => {
+    localStorage.clear();
+    window.history.replaceState({}, '', '/');
+    Object.defineProperty(navigator, 'languages', {
+      configurable: true,
+      value: originalLanguages,
+    });
+  });
+
+  test('resolves a Vietnamese regional browser locale to Vietnamese', () => {
+    expect(AppI18n.getBrowserLocale()).toBe(Locales.VI);
+    expect(AppI18n.getUserLocale()).toBe(Locales.VI);
+  });
+
+  test('defaults to Vietnamese when no saved locale exists, regardless of browser language', () => {
+    setBrowserLanguages('en-US');
+
+    expect(AppI18n.getDefaultLocale()).toBe(Locales.VI);
+    expect(AppI18n.getUserLocale()).toBe(Locales.VI);
+  });
+
+  test('keeps a saved locale ahead of the browser locale', () => {
+    localStorage.setItem('user.locale', 'es');
+
+    expect(AppI18n.getUserLocale()).toBe(Locales.ES);
+    expect(localStorage.getItem('user.locale')).toBe('es');
+  });
+
+  test('keeps an account locale ahead of a saved locale', () => {
+    localStorage.setItem('user.locale', 'es');
+
+    expect(AppI18n.getUserLocale(Locales.FR)).toBe(Locales.FR);
+    expect(localStorage.getItem('user.locale')).toBe('fr');
+  });
+
+  test('reads a Vietnamese locale prefix on public authentication routes', () => {
+    window.history.replaceState({}, '', '/vi/c/login');
+
+    expect(AppI18n.getUserLocale()).toBe(Locales.VI);
+    expect(localStorage.getItem('user.locale')).toBe('vi');
+  });
+});
